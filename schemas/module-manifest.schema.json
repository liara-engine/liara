{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liara-engine.github.io/liara/schemas/module-manifest.schema.json",
  "title": "Liara Engine Module Manifest",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "metadata",
    "versions"
  ],

  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "description": "Metadata about the module.",

      "required": [
        "name",
        "description",
        "latest"
      ],

      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The name of the module."
        },

        "description": {
          "type": "string",
          "minLength": 1,
          "description": "A brief description of the module."
        },

        "latest": {
          "$ref": "#/$defs/version",
          "description": "The latest version of the module.",
          "examples": [ "dev", "1.0.0" ]
        }
      }
    },

    "versions": {
      "type": "object",
      "minProperties": 1,
      "description": "A mapping of version labels to their respective compatibility information.",

      "patternProperties": {
        "^(dev|\\d+\\.\\d+\\.\\d+)$": {
          "type": "object",
          "additionalProperties": false,

          "required": [
            "abi_compatibility"
          ],

          "properties": {
            "abi_compatibility": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "description": "A list of ABI versions that this module version is compatible with.",

              "items": {
                "$ref": "#/$defs/version"
              }
            }
          }
        }
      },

      "additionalProperties": false
    }
  },

  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(dev|\\d+\\.\\d+\\.\\d+)$"
    }
  }
}