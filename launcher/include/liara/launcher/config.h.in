#define LIARA_LAUNCHER_VERSION LIARA_MAKE_VERSION_UNSAFE( \
    @PROJECT_VERSION_MAJOR@,                              \
    @PROJECT_VERSION_MINOR@,                              \
    @PROJECT_VERSION_PATCH@                               \
)

#define LIARA_LAUNCHER_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define LIARA_LAUNCHER_VERSION_MINOR @PROJECT_VERSION_MINOR@
